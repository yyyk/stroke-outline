{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG": "${sourceDir}/bin/${presetName}",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE": "${sourceDir}/bin/${presetName}"
      }
    },
    {
      "name": "native",
      "inherits": "default",
      "displayName": "Native (host compiler)"
    },
    {
      "name": "wasm",
      "inherits": "default",
      "displayName": "WebAssembly (Emscripten)",
      "cacheVariables": { "USE_EMSCRIPTEN": "ON" }
    },
    {
      "name": "coverage",
      "inherits": "default",
      "displayName": "Native with clang coverage (see cmake/Coverage.cmake)",
      "cacheVariables": { "STROKE_OUTLINE_COVERAGE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "native-debug",   "configurePreset": "native", "configuration": "Debug" },
    { "name": "native-release", "configurePreset": "native", "configuration": "Release" },
    { "name": "wasm-debug",     "configurePreset": "wasm",   "configuration": "Debug" },
    { "name": "wasm-release",   "configurePreset": "wasm",   "configuration": "Release" },
    { "name": "coverage",       "configurePreset": "coverage", "configuration": "Debug", "targets": ["coverage"] }
  ],
  "testPresets": [
    { "name": "native-debug",   "configurePreset": "native", "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "native-release", "configurePreset": "native", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
