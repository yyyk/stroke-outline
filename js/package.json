{
  "name": "stroke-outline",
  "version": "0.1.2",
  "description": "Stroke vector paths into fillable outlines: joins, caps, dashes, inside/outside alignment and clipping. WebAssembly build of a C++ library.",
  "keywords": [
    "stroke",
    "outline",
    "path",
    "svg",
    "vector",
    "bezier",
    "dash",
    "canvas",
    "geometry",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyyk/stroke-outline.git",
    "directory": "js"
  },
  "homepage": "https://yyyk.github.io/stroke-outline/",
  "bugs": "https://github.com/yyyk/stroke-outline/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-wasm.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
